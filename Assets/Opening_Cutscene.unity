  - {fileID: 21300000, guid: 0c5de9563c441064ea18f369621e6e0f, type: 3}
  startDelay: 0
  abah: {fileID: 704895864}
  rimba: {fileID: 812000220}
  abahName: Abah
  rimbaName: Rimba
  turnDelay: 1
  dialoguePanel: {fileID: 122720446}
  panelGroup: {fileID: 122720450}
  speakerLabel: {fileID: 775325988}
  bodyLabel: {fileID: 1228079827}
  indicatorImage: {fileID: 302093777}
  indicatorGroup: {fileID: 302093776}
  charsPerSecond: 40
  gapBetweenLines: 0.3
  returnToWatchAfterDialogue: 0
  panelShowSeconds: 0.12
  panelHideSeconds: 0.1
  panelRisePx: 12
  indicatorBlinkSeconds: 0.45
  abahSpeakerColor: {r: 0.95686275, g: 0.72156864, b: 0.3764706, a: 1}
  rimbaSpeakerColor: {r: 0.49411765, g: 0.8392157, b: 0.78431374, a: 1}
  commaPause: 0.12
  sentencePause: 0.28
  targetCamera: {fileID: 961739752}
  cutsceneAudio: {fileID: 1996629190}
  segments:
  - label: pembuka
    startFrame: 0
    endFrame: 0
    secondsPerFrame: 2
    repeatCount: 1
    holdLastFrame: 0
    lines:
    - speaker: Rimba
      text: Abah, ceritakan lagi asal-usul karinding itu, dong.
      holdSeconds: 3
    - speaker: Abah
      text: Konon, sebelum ada kehidupan, tak ada apa-apa. Awang uwung tong enong
        marga na enong, Kosong.
      holdSeconds: 4.5
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: Frekuensi
    startFrame: 1
    endFrame: 11
    secondsPerFrame: 0.1
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Hingga suatu ketika, dari kekosongan itu lahir getar, dan getar melahirkan
        dengung.
      holdSeconds: 4.5
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: meledak
    startFrame: 12
    endFrame: 25
    secondsPerFrame: 0.1
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Dari dengung itu, dunia mulai bergerak.
      holdSeconds: 3
    shakeSeconds: 1.2
    shakeStrengthPx: 2
  - label: planet
    startFrame: 26
    endFrame: 32
    secondsPerFrame: 0.15
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Rimba
      text: Itu dunia kita, Bah?
      holdSeconds: 2
    - speaker: Abah
      text: Betul, Cu. Itulah bumi, yang lahir dari dengung.
      holdSeconds: 3
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: tumbuh
    startFrame: 33
    endFrame: 45
    secondsPerFrame: 0.1
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Gunung berdiri, air mengalir turun menuju laut.
      holdSeconds: 3
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: kehidupan
    startFrame: 46
    endFrame: 48
    secondsPerFrame: 0.4
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Dan kehidupan pun tumbuh di antara keduanya.
      holdSeconds: 3
    - speaker: Abah
      text: Karuhun kita memahami ini bukan lewat kitab, tapi lewat alam itu sendiri.
      holdSeconds: 4
    - speaker: Rimba
      text: Alam? Maksud Abah, hutan?
      holdSeconds: 2.5
    - speaker: Abah
      text: Mereka membagi hutan menjadi tiga.
      holdSeconds: 2.5
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: htn.larangan
    startFrame: 49
    endFrame: 51
    secondsPerFrame: 0.4
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Leuweung Larangan adalah tempat yang disucikan.
      holdSeconds: 3
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: htn.tutupan
    startFrame: 52
    endFrame: 54
    secondsPerFrame: 0.4
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Leuweung Tutupan, tempat kita belajar, lalu lahirlah kesadaran.
      holdSeconds: 3.5
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: baladahan
    startFrame: 55
    endFrame: 57
    secondsPerFrame: 0.4
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Leuweung Baladahan, tempat kita berladang, lalu munculnya kesabaran.
      holdSeconds: 4
    shakeSeconds: 0
    shakeStrengthPx: 0
  - label: penutupan
    startFrame: 58
    endFrame: 60
    secondsPerFrame: 0.4
    repeatCount: 1
    holdLastFrame: 0.5
    lines:
    - speaker: Abah
      text: Yakin, Sadar, Sabar.
      holdSeconds: 2
    - speaker: Rimba
      text: Yakin, sadar, sabar...
      holdSeconds: 2
    - speaker: Abah
      text: Tiga hal yang dijaga turun-temurun, dirawat dari generasi ke generasi,
      holdSeconds: 4
    - speaker: Abah
      text: seperti batas yang ditetapkan lalu dipelihara, netepkeun lalu netepan.
      holdSeconds: 4
    - speaker: Abah
      text: Sebab apa yang tak dirawat akan hilang, dan apa yang hilang akan dicari.
      holdSeconds: 4
    - speaker: Abah
      text: Tiga hal yang sama, yang kelak dituangkan di dalam sebilah bambu kecil.
      holdSeconds: 4
    - speaker: Abah
      text: Digenggam dengan yakin, dipukul dengan sabar, dan didengarkan dengan
        sadar.
      holdSeconds: 4
    - speaker: Abah
      text: Karena suara yang keluar darinya bukan sekadar suara.
      holdSeconds: 3.5
    - speaker: Abah
      text: Ia gema dari getar pertama yang melahirkan dunia.
      holdSeconds: 3
    shakeSeconds: 0
    shakeStrengthPx: 0
  endDelay: 2.5
  nextSceneName: 
  screenFade: {fileID: 146117557}
  fadeInSeconds: 1
  screenFadeOutSeconds: 1
  musicFadeOutSeconds: 3
